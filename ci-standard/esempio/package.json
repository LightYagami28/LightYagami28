{
  "name": "ci-standard-esempio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --test test/seo-check.test.ts",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** --test-reporter=lcov --test-reporter-destination=lcov.info test/seo-check.test.ts",
    "build": "node -e \"import('./src/cli.ts').then((cli) => cli.start())\" build",
    "seo:check": "node -e \"import('./src/cli.ts').then((cli) => cli.start())\" seo dist/index.html"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
